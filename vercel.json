{
    "crons": [
        {
            "path": "/api/internal/automation/run",
            "schedule": "0 0 * * *"
        }
    ],
    "services": {
        "frontend": {
            "root": ".",
            "framework": "vite",
            "rewrites": [
                {
                    "source": "/(.*)",
                    "destination": "/index.html"
                }
            ]
        },
        "backend": {
            "root": "backend",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}