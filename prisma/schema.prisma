// Prisma schema file for Sales CRM
// Configured for PostgreSQL (Supabase) with Prisma 7

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. White-label branding & system configuration
model Branding {
  id                    String   @id @default("default")
  appName               String   @default("NexusCRM")
  tagline               String   @default("Customizable B2B Sales & Recurring Order Platform")
  logoIcon              String   @default("Building2")
  primaryColor          String   @default("#2563eb")
  accentColor           String   @default("#10b981")
  defaultRecurrenceDays Int      @default(60)
  customFields          Json?
  updatedAt             DateTime @updatedAt
}

// 2. Staff & Users
model User {
  id        String   @id
  name      String
  email     String   @unique
  role      String   @default("Sales Rep")
  active    Boolean  @default(true)
  avatarUrl String?
  passwordHash String?
  sessions Session[]
  companies Company[] @relation("CompanyOwner")
  contacts Contact[] @relation("ContactOwner")
  leads Lead[] @relation("LeadOwner")
  deals Deal[] @relation("DealOwner")
}

model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// 3. Sales pipelines and their stages
model Pipeline {
  id                 String @id
  name               String @unique
  active             Boolean @default(true)
  qualificationRules Json?
  stages             Stage[]
  deals              Deal[]
}

model Stage {
  id       String @id
  pipelineId String @default("pipeline-sales")
  code     String
  name     String
  order    Int
  category String
  color    String @default("#FFFFFF")
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  deals Deal[]

  @@unique([pipelineId, name])
  @@unique([pipelineId, code])
  @@index([pipelineId, order])
}

// 4. Accounts / Companies
model Company {
  ownerId   String?
  id        String  @id
  name      String
  industry  String?
  website   String?
  address   String?
  notes     String?
  createdAt String?
  owner User? @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  contacts Contact[]
  deals Deal[]

  @@index([ownerId])
}

// 5. Contacts
model Contact {
  id           String  @id
  name         String
  email        String?
  phone        String?
  jobTitle     String?
  companyId    String?
  companyName  String?
  ownerId      String?
  ownerName    String?
  customFields Json?
  createdAt    String?
  owner User? @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deals Deal[]

  @@index([ownerId])
  @@index([companyId])
}

// 6. Leads
model Lead {
  id               String  @id
  title            String
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  companyName      String?
  source           String?
  isOutbound       Boolean @default(false)
  status           String  @default("New")
  ownerId          String?
  ownerName        String?
  createdAt        String?
  lastActivityDate String?
  pendingGateCheck Json?
  customFields     Json?
  owner User? @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  deals Deal[]

  @@index([ownerId])
}

// 7. Deals / Pipeline Opportunities
model Deal {
  id                 String  @id
  pipelineId         String  @default("pipeline-sales")
  parentDealId       String?
  leadId             String?
  title              String
  value              Float   @default(0)
  currency           String  @default("INR")
  stageId            String
  stageName          String
  expectedCloseDate  String?
  actualCloseDate    String?
  contactId          String?
  contactName        String?
  companyId          String?
  companyName        String?
  ownerId            String?
  ownerName          String?
  isRecurring        Boolean @default(false)
  isRebuy            Boolean @default(false)
  recurrenceDays     Int     @default(60)
  status             String  @default("Active")
  createdAt          String?
  updatedAt          String?
  lastActivityDate   String?
  daysInStage        Int     @default(0)
  valueHistory       Json?
  reason             String?
  lostReason         String?
  lostReasonNote     String?
  lostStageId        String?
  lostStageName      String?
  proposalExpiryDate String?
  pendingGateCheck   Json?
  partialGateState   Json?
  customFields       Json?
  owner User? @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage Stage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parentDeal Deal? @relation("DealLineage", fields: [parentDealId], references: [id], onDelete: Restrict)
  rebuyDeals Deal[] @relation("DealLineage")
  approvalChecks StageGateCheck[]

  @@index([ownerId, status])
  @@index([pipelineId, stageId])
  @@index([stageId])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([parentDealId])
}

// 8. Follow-up Tasks & Manager Approval Ledgers
model Task {
  id               String  @id
  title            String
  dueDate          String?
  type             String  @default("Call")
  linkedType       String?
  linkedId         String?
  linkedTitle      String?
  ownerId          String?
  ownerName        String?
  status           String  @default("pending")
  stageGateCheckId String?
  answers          Json?
  repObservations  String?
  submittedBy      String?
  submittedByName  String?
  submittedAt      String?
  reviewedByName   String?
  resolution       String?
  note             String?
  fromStageName    String?
  targetStageName  String?
  createdAt        String?
  approvalCheck StageGateCheck? @relation(fields: [stageGateCheckId], references: [id], onDelete: Restrict)

  @@index([stageGateCheckId])
}

// 9. Notes
model Note {
  id         String  @id
  text       String
  timestamp  String?
  authorId   String?
  authorName String?
  linkedType String?
  linkedId   String?
  createdAt  String?
}

// 10. Activity Timeline Logs
model Activity {
  id              String   @id
  type            String
  description     String
  timestamp       String?
  linkedType      String?
  linkedId        String?
  linkedTitle     String?
  authorId        String?
  authorName      String?
  performedByName String?
  assignedToName  String?
  stageId         String?
  stageName       String?
  isOutbound      Boolean? @default(false)
  metadata        Json?
  createdAt       String?
}

// 11. Stage Gate Qualification Checks
model StageGateCheck {
  id              String  @id
  dealId          String
  dealTitle       String?
  fromStageId     String?
  fromStageName   String?
  targetStageId   String?
  targetStageName String?
  submittedBy     String?
  submittedByName String?
  reviewedBy      String?
  reviewedByName  String?
  status          String  @default("pending")
  answers         Json?
  outcome         String?
  lostReason      String?
  note            String?
  timestamp       String?
  createdAt       String?
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Restrict)
  tasks Task[]

  @@index([dealId])
}

// 12. Permanent Audit Trail
model AuditLog {
  id          String  @id
  timestamp   String
  actorId     String
  actorName   String
  action      String
  entityType  String
  entityId    String
  entityTitle String?
  fromStage   String?
  toStage     String?
  reason      String?
  metadata    Json?
}

model LoginAttempt {
  keyHash      String   @id
  count        Int      @default(0)
  windowEndsAt DateTime

  @@index([windowEndsAt])
}

model AccountInvitation {
  tokenHash String   @id
  userId    String
  createdBy String
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model Attachment {
  id          String   @id
  recordType  String
  recordId    String
  storagePath String   @unique
  filename    String
  contentType String
  size        Int
  createdById String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
  purgedAt    DateTime?

  @@index([recordType, recordId, deletedAt])
  @@index([createdAt])
}

model AutomationRun {
  id              String   @id
  status          String   @default("idle")
  nextRunAt       DateTime @default(now())
  lockedUntil     DateTime?
  leaseToken      String?
  lastStartedAt   DateTime?
  lastCompletedAt DateTime?
  attempts        Int      @default(0)
  runCount        Int      @default(0)
  lastError       String?
  updatedAt       DateTime @updatedAt

  @@index([nextRunAt, lockedUntil])
}

model AutomationEvent {
  id          String   @id
  trigger     String
  context     Json
  status      String   @default("pending")
  attempts    Int      @default(0)
  nextRunAt   DateTime @default(now())
  lockedUntil DateTime?
  leaseToken  String?
  lastError   String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([status, nextRunAt, lockedUntil])
}

// Keeps source IDs when historical records refer to deleted or missing records.
model OrphanReference {
  id           String   @id
  recordType   String
  recordId     String
  field        String
  targetType   String
  targetId     String
  detectedAt   DateTime @default(now())
  resolvedAt   DateTime?
  resolvedTargetId String?

  @@unique([recordType, recordId, field])
  @@index([targetType, targetId])
}
