# Environment variables for AI Studio (Optional)
GEMINI_API_KEY=

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Exact external origin when deployed behind a reverse proxy (no trailing slash).
# APP_ORIGIN=https://crm.example.com
# Keep the frontend and API on the same origin for JSON write protection.
# A 32+ character bearer secret for POST /api/internal/automation/run, called by an external scheduler.
# CRON_SECRET=
# Production access requires an administrator password. Run npm run admin:create first.

# Private Supabase Storage bucket for customer record attachments.
# Create a private bucket named crm-attachments (or set CRM_ATTACHMENTS_BUCKET).
# The service-role key is server-only; never expose it in Vite/frontend variables.
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# CRM_ATTACHMENTS_BUCKET=crm-attachments

# Google Workspace communication sync (server-only).
# Enable Gmail API and Google Calendar API in a Google Cloud project, configure
# the OAuth consent screen, and register this exact web-client redirect URI:
# https://your-crm-origin/api/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# A 32-byte hex or base64 key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key stable: changing it requires all users to reconnect.
# INTEGRATION_ENCRYPTION_KEY=
